{
  "manifest_version": 3,
  "name": "AI Browser Agent",
  "version": "0.2.0",
  "description": "Lets local AI agents (Claude Code, Codex) control this browser through a local MCP server.",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "tabs",
    "scripting",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "options.html",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
